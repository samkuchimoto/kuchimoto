# Copy to .env.local for local work; set the same names in Vercel
# (Project > Settings > Environment Variables) for the live site.

# The scope inquiry form saves leads here (the Vercel Neon integration
# sets it). Unset, inquiries are only emailed.
DATABASE_URL=

# Inquiries are emailed through Resend. In development without a key,
# they are printed to the console instead.
RESEND_API_KEY=
# Where inquiries arrive; several addresses separated by commas.
CONTACT_TO_EMAIL=
# The sender, on a domain verified in Resend, e.g. KUCHIMOTO <contact@kuchimoto.com>
CONTACT_FROM_EMAIL=
# Optional: the sender of the reply to the visitor (default Samuel Louissaint <samuel@kuchimoto.com>).
LEAD_REPLY_FROM=

# The Stripe webhook (/api/stripe/webhook) still receives this account's
# checkout events. Point the webhook at https://www.kuchimoto.com/api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
