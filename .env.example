# Copy to .env.local for local work; set the same names in Vercel
# (Project > Settings > Environment Variables) for the live site.

# Forms (contact, waiting lists, Lab projects, booking requests) are
# emailed through Resend. Unset, the forms say sending is not open yet.
RESEND_API_KEY=
# Where submissions arrive; several addresses separated by commas.
CONTACT_TO_EMAIL=
# The sender, on a domain verified in Resend, e.g. KUCHIMOTO <contact@kuchimoto.com>
CONTACT_FROM_EMAIL=

# Card payments for Happy Homes Thailand, on the company's Stripe account.
# Unset, bookings are sent as requests and the form says card payment
# opens soon.
STRIPE_SECRET_KEY=
# From the webhook pointed at https://kuchimoto.com/api/stripe/webhook
# (event: checkout.session.completed). It emails each paid booking.
STRIPE_WEBHOOK_SECRET=
